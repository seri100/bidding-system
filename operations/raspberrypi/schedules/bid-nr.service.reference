# /etc/systemd/system/bid-nr.service
[Unit]
Description=Bid NR Collector
[Service]
Type=oneshot
WorkingDirectory=/home/pi/bid-nr
ExecStart=/usr/bin/flock -n -E 99 /tmp/bid-nr.lock /usr/bin/python3 -u /home/pi/bid-nr/main_nr.py
# /etc/systemd/system/bid-nr.service.d/storage-guard.conf
[Unit]
After=network-online.target
[Service]
# /etc/systemd/system/bid-nr.service.d/user.conf
[Service]
User=pi
Group=pi
