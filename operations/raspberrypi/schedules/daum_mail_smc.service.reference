# /etc/systemd/system/daum_mail_smc.service
[Unit]
Description=Daum Mail SMC Sync
After=network-online.target
[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/n_data/daum_mail
ExecStart=/usr/bin/python3 -u /home/pi/n_data/daum_mail/daum_mail_sync.py --days 1 --max 10 --include-subject "SMC" --apply
