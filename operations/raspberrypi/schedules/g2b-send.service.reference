# /etc/systemd/system/g2b-send.service
[Unit]
Description=Seri G2B notifier (main_send.py)
After=network.target
[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/seri_Alarm_Server6
ExecStart=/usr/bin/python3 -u /home/pi/seri_Alarm_Server6/main_send.py
[Install]
WantedBy=multi-user.target
# /etc/systemd/system/g2b-send.service.d/env.conf
[Service]
