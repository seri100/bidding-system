# /etc/systemd/system/lh-crawl.service
[Unit]
Description=Seri LH crawler (main_crawling.py)
After=network.target
[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/seri_Alarm_Server6
ExecStart=/usr/bin/python3 -u /home/pi/seri_Alarm_Server6/main_crawling.py
[Install]
WantedBy=multi-user.target
# /etc/systemd/system/lh-crawl.service.d/env.conf
[Service]
