# /etc/systemd/system/lh-main.service
[Unit]
Description=LH Bid Fetch & Notify
After=network-online.target
[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/home/pi/seri_Alarm_Server6/lh
ExecStart=/usr/bin/python3 -u /home/pi/seri_Alarm_Server6/lh/lh_main.py
[Install]
WantedBy=multi-user.target
# /etc/systemd/system/lh-main.service.d/override.conf
[Service]
User=pi
Group=pi
WorkingDirectory=/home/pi/seri_Alarm_Server6/lh
ExecStart=
ExecStart=/usr/local/bin/lh-main-run.sh
