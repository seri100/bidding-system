OnCalendar=Mon..Fri *-*-* 13:45:00
OnCalendar=Mon..Fri *-*-* 14:00:00
OnCalendar=Mon..Fri *-*-* 14:15:00
OnCalendar=Mon..Fri *-*-* 14:30:00
OnCalendar=Mon..Fri *-*-* 14:45:00
OnCalendar=Mon..Fri *-*-* 15:00:00
OnCalendar=Mon..Fri *-*-* 15:15:00
OnCalendar=Mon..Fri *-*-* 15:30:00
OnCalendar=Mon..Fri *-*-* 15:45:00
OnCalendar=Mon..Fri *-*-* 16:00:00
OnCalendar=Mon..Fri *-*-* 16:15:00
OnCalendar=Mon..Fri *-*-* 16:30:00
OnCalendar=Mon..Fri *-*-* 16:45:00
OnCalendar=Mon..Fri *-*-* 17:00:00
OnCalendar=Mon..Fri *-*-* 17:15:00
