# /etc/systemd/system/ndata-main-send.service
[Unit]
Description=NDATA main_send auto runner
After=network-online.target
[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/n_data
ExecStart=/usr/bin/python3 -u /home/pi/n_data/main_send.py
[Install]
WantedBy=multi-user.target
# /etc/systemd/system/ndata-main-send.service.d/env-testmode.conf
[Service]
