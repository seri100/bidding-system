# /etc/systemd/system/seri-gon-auto.service
[Unit]
Description=Seri GON_AUTO (G2B) Runner - Server3
After=network-online.target mnt-vol1.mount
[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/home/pi/seri_Alarm_Server3
ExecStart=/usr/bin/flock -n /tmp/seri_gon_auto.lock /bin/bash -lc '/usr/bin/python3 -u /home/pi/seri_Alarm_Server3/gd_2512.py >> /mnt/vol1/bid/gon_auto/logs/seri_gon_auto.log 2>&1'
